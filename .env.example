PORT=5000
NODE_ENV=production

# Frontend/API
FRONTEND_URL=https://tiffin.rkveda.in
API_PUBLIC_URL=https://tiffin-api.rkveda.in

# Hostinger MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rkveda_tiffin
DB_USER=YOUR_HOSTINGER_DB_USER
DB_PASSWORD=YOUR_HOSTINGER_DB_PASSWORD

# Auth
JWT_SECRET=CHANGE_TO_LONG_RANDOM_SECRET

# Payment gateway
PAYMENT_GATEWAY=cashfree

# Cashfree: sandbox for testing, production for live
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_WEBHOOK_TOLERANCE_SECONDS=300
CASHFREE_RETURN_URL=https://tiffin.rkveda.in/payment/callback?order_id={order_id}
CASHFREE_NOTIFY_URL=https://tiffin-api.rkveda.in/api/payments/cashfree/webhook

# Uploads
UPLOAD_DIR=public/uploads
